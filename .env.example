# Optional: GitHub personal access token for higher rate limits
# Create at: https://github.com/settings/tokens (no special scopes needed for public data)
GITHUB_TOKEN=

# LLM Configuration (Phase 2)
# Choose provider: "google" or "openai"
LLM_PROVIDER=google

# Provide the appropriate API key
# GOOGLE_API_KEY=
# OPENAI_API_KEY=

# Optional tuning
# LLM_MODEL=gemini-2.0-flash
# LLM_TEMPERATURE=0.1
